#List available time zones:
#systemsetup -listtimezones

#Set the time zone:
#systemsetup -settimezone <time_zone> 
#(for example, sudo systemsetup -settimezone America/New_York)

#Check network time status:
systemsetup -getusingnetworktime
nts=$(systemsetup -getnetworktimeserver)
echo $nts
sntp pool.ntp.org 2>/dev/null # check time against world
sntp $(echo $nts |awk -F: '{print $2}') # check time slew against configged ntp server

