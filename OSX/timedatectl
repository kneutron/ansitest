#!/bin/bash 

# 2026.Aug kneutron - systemsetup needs root/sudo

TZ=$(systemsetup -gettimezone)
#ltime="$(gdate +%a) $(gdate +%F) $(gdate +%H:%M:%S) $(gdate +%Z)"
ltime="$(date +%a) $(date +%F) $(date +%H:%M:%S) $(date +%Z)"
tz1=$(date +%Z)
tz2=$(date +%z)

echo -e "\t\tLocal time: \t\t$ltime"
echo -e "\t\tUniversal time: \t$(date -u)"
echo -e "\t\tRTC time: n/a"
echo -e "\t\t$TZ ($tz1, $tz2)"

#Check current time zone:
